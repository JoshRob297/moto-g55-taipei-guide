#!/sbin/sh
#################
# Magisk Module #
#################
umask 022
ZIPFILE="$3"
OUTFD="$2"

ui_print() {
  echo -e "ui_print $1\nui_print" >> /proc/self/fd/$OUTFD
}

ui_print "**********************************************"
ui_print "  Motorola Carrier & Telemetry Debloater      "
ui_print "       For Moto G55 5G (XT2435-1 / taipei)    "
ui_print "**********************************************"

TMPDIR=/dev/tmp
mkdir -p $TMPDIR
unzip -o "$ZIPFILE" -d $TMPDIR >&2

MODPATH=/data/adb/modules/moto_g55_carrier_debloater
rm -rf $MODPATH
mkdir -p $MODPATH

cp -rf $TMPDIR/* $MODPATH/
chmod 755 $MODPATH/service.sh

ui_print "- Module successfully installed."
ui_print "- Carrier background packages and telemetry disabled."
ui_print "**********************************************"
exit 0
